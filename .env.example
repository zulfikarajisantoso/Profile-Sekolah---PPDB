# Nama situs, dipakai untuk metadata SEO dan sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kunci penanda tangan cookie sesi admin (WAJIB diganti di production, minimal 16 karakter).
SESSION_SECRET=ganti-dengan-string-acak-minimal-16-karakter

# Lokasi file SQLite. Kosongkan untuk memakai ./data/sekolah.sqlite
# DATABASE_FILENAME=/var/lib/sekolah/sekolah.sqlite

# Akun admin pertama yang dibuat oleh `npm run db:seed`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sekolah123
